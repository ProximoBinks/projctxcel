# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=sensible-hornet-978
NEXT_PUBLIC_CONVEX_URL=
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
CONTACT_TO_EMAIL=
POSTMARK_SMTP_USER=
POSTMARK_SMTP_PASS=
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_CONVEX_SITE_URL=
AUTH_JWT_SECRET=
TUTOR_SIGNUP_SECRET=

# Shared secret proving a Convex call comes from our own server (API routes),
# not directly from a browser. Gates account creation + password-reset/verify
# mutations. Generate with: openssl rand -hex 32
# IMPORTANT: set the SAME value in BOTH places:
#   - Next.js/Netlify env (this file / Netlify dashboard)
#   - Convex deployment:  npx convex env set CONVEX_SERVER_SECRET <value>
CONVEX_SERVER_SECRET=

# RS256 private key (base64-encoded PKCS8 PEM) used to mint the short-lived
# tokens Convex validates via ctx.auth. Server-side only (Netlify + local).
# The public JWK is derived from this at runtime and served at
# /.well-known/jwks.json. Generate a new keypair with jose's generateKeyPair.
CONVEX_AUTH_PRIVATE_KEY=
# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=
